# 使用 demo 时数据写入独立的 data/demo.sqlite。
# 改为 owner 后将使用 data/palace.sqlite，且不会载入 Demo 数据。
MEMORY_PALACE_DATASET=demo
MEMORY_PALACE_DATA_DIR=./data
# 不再设置旧馆长密码：正式登录统一使用注册账号的邮箱和密码。
# 用独立随机值保护验证码哈希和分享访问凭据，生产环境至少 32 个字符。
MEMORY_PALACE_SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
# 仅在通过 HTTP 公网 IP 验证时设为 false；正式 HTTPS 上线后必须为 true。
MEMORY_PALACE_SECURE_COOKIES=false
# 单一平台管理员：填已完成邮箱验证的 User UUID；留空禁用。不是馆长旧密码。
# 仅服务器可设置；不得添加 NEXT_PUBLIC_ 前缀或填写多个账号。
MEMORY_PALACE_PLATFORM_ADMIN_USER_ID=
# Task 13B：注册/找回密码/修改密码统一六位验证码。发件域名需在 Resend 中完成验证。
# 不要将真实密钥提交到版本库。
RESEND_API_KEY=replace-with-resend-api-key
MEMORY_PALACE_EMAIL_FROM=Personal Memory Palace <verify@your-verified-domain.example>


# Docker 生产环境：
# MEMORY_PALACE_DATASET=owner
# MEMORY_PALACE_DATA_DIR=/app/data
