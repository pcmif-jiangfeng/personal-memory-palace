{
  "name": "personal-memory-palace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{json,mjs,ts}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "db:init": "node --experimental-strip-types scripts/init-db.ts",
    "db:demo:reset": "node --experimental-strip-types scripts/init-db.ts --reset",
    "files:recover": "node --experimental-strip-types scripts/recover-file-operations.ts",
    "backup:manual": "node scripts/backup.mjs",
    "backup:restore-test": "node scripts/restore-backup.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0"
  }
}
